node_modules
.pnpm-store

# next
.next
out
next-env.d.ts

# env
.env
.env.local
.env.*.local

# owner-uploaded photos (local dev only — prod lives OUTSIDE deploy)
uploads/

# sqlite (db lives OUTSIDE deploy on Hostinger; never commit)
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db

# build artifacts
dist
*.tsbuildinfo

# editor / os
.DS_Store
.idea
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# coverage
coverage

# vendored Atelier sub-app — keep source, exclude build + deps
templates/atelier-base/node_modules
templates/atelier-base/.next*
templates/atelier-base/*.tsbuildinfo

# stray local junk
*.jar

# Atelier template runtime state: HMAC secrets, the admin hash, client PII, bookings,
# orders, mail log, audit log, install stats. Regenerated by the app on first use
# (secret.json) or shipped empty by the ZIP builder; never committed again.
templates/atelier-base/data/secret.json
templates/atelier-base/data/users.json
templates/atelier-base/data/clients.json
templates/atelier-base/data/bookings.json
templates/atelier-base/data/emails.log.json
templates/atelier-base/data/audit.json
templates/atelier-base/data/orders.json
templates/atelier-base/data/install-stats.json
